import cv2 as cv
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import pandas as pd
import os

# Set Seaborn style (this makes the graph look professional)
sns.set_theme(style="whitegrid")

def plot_rgb_seaborn(df, samples=100):
    print(f"🔄 Processing {samples} images for Seaborn plot...")
    
    if df.empty:
        print("❌ Error: DataFrame is empty!")
        return

    # Select random samples from the dataframe
    sample_indices = np.random.choice(len(df), min(samples, len(df)), replace=False)
    
    # List to store data for plotting
    plot_data = []
    
    valid_count = 0
    
    for idx in sample_indices:
        img_path = df.iloc[idx]['filepaths']
        
        # Check if the file path exists
        if not os.path.exists(img_path):
            continue 
            
        try:
            img = cv.imread(img_path)
            if img is not None:
                img = cv.cvtColor(img, cv.COLOR_BGR2RGB)
                
                # Calculate histograms for 3 channels (Red, Green, Blue)
                r_hist = cv.calcHist([img], [0], None, [256], [0, 256]).flatten()
                g_hist = cv.calcHist([img], [1], None, [256], [0, 256]).flatten()
                b_hist = cv.calcHist([img], [2], None, [256], [0, 256]).flatten()
                
                # Normalize histograms (so all images have the same scale)
                r_hist /= r_hist.sum()
                g_hist /= g_hist.sum()
                b_hist /= b_hist.sum()

                # Prepare data for DataFrame
                # We store all data points so Seaborn can automatically calculate the Mean and Confidence Interval (Shadow)
                for i in range(256):
                    plot_data.append({'Intensity': i, 'Frequency': r_hist[i], 'Channel': 'Red'})
                    plot_data.append({'Intensity': i, 'Frequency': g_hist[i], 'Channel': 'Green'})
                    plot_data.append({'Intensity': i, 'Frequency': b_hist[i], 'Channel': 'Blue'})
                
                valid_count += 1
        except Exception as e:
            print(f"Skipping error: {e}")

    if valid_count == 0:
        print("\n❌ Error: No images loaded! Please check file paths.")
        return

    print(f"✅ {valid_count} images processed. Converting to DataFrame...")
    
    # Create Pandas DataFrame from the list
    vis_df = pd.DataFrame(plot_data)

    print("📊 Plotting with Seaborn...")

    # --- SEABORN PLOTTING ---
    plt.figure(figsize=(12, 7), dpi=120)
    
    # Using lineplot allows Seaborn to automatically show the 'Shadow' (Confidence Interval)
    # This gives the graph a high-quality research paper look
    sns.lineplot(data=vis_df, x='Intensity', y='Frequency', hue='Channel', 
                 palette={'Red': 'r', 'Green': 'g', 'Blue': 'b'}, linewidth=2)

    plt.title(f'RGB Channel Intensity Distribution (Sampled {valid_count} Images)', fontsize=16, fontweight='bold')
    plt.xlabel('Pixel Intensity (0-255)', fontsize=12)
    plt.ylabel('Normalized Frequency', fontsize=12)
    plt.xlim(0, 255)
    
    # Save the graph
    plt.savefig('seaborn_rgb_graph.png', bbox_inches='tight')
    print("💾 Graph saved as 'seaborn_rgb_graph.png'")
    
    plt.show()

# Call the function
# Note: Keep samples=50 or 100. Higher values may take more time due to Seaborn calculations.
plot_rgb_seaborn(data, samples=50)











