# --- 1. Training Generator (With Augmentation) ---
train_datagen = ImageDataGenerator(
    rescale=1./255,             # Normalize pixel values [0, 255] -> [0, 1]
    rotation_range=20,          # Random rotation between -20 to +20 degrees
